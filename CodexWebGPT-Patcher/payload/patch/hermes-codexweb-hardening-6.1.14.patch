diff --git a/launcher/tests/cookie-priority-smoke.cjs b/launcher/tests/cookie-priority-smoke.cjs
new file mode 100644
index 0000000..b77b9b3
--- /dev/null
+++ b/launcher/tests/cookie-priority-smoke.cjs
@@ -0,0 +1,67 @@
+// Run with Electron: synthetic cookies only, in a disposable profile, with no network requests.
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { app, BrowserWindow } = require("electron");
+const { BrowserHost } = require("../electron/browser-host.cjs");
+
+const profile = fs.mkdtempSync(path.join(os.tmpdir(), "codex-cookie-priority-"));
+app.setPath("userData", profile);
+const windows = [];
+
+async function stress(protectedCookies) {
+  const window = new BrowserWindow({ show: false, webPreferences: {
+    partition: `cookie-priority-${protectedCookies}`, sandbox: true,
+  } });
+  windows.push(window);
+  const contents = window.webContents;
+  await contents.loadURL("data:text/html,<title>Cookie priority test</title>");
+  const cookieStore = contents.session.cookies;
+  const host = Object.assign(Object.create(BrowserHost.prototype), { view: { webContents: contents } });
+  const auth = [0, 1].map(index => ({
+    url: "https://chatgpt.com/", name: `__Secure-next-auth.session-token.${index}`,
+    value: "synthetic", secure: true, httpOnly: true, path: "/", sameSite: "lax",
+    expirationDate: Math.floor(Date.now() / 1000) + 86_400,
+  }));
+  for (const cookie of auth) await cookieStore.set(cookie);
+  if (protectedCookies) await host.setChatGptCookies(auth);
+  for (let i = 0; i < 240; i++) {
+    const id = `${i.toString(16).padStart(8, "0")}-0000-8000-8000-000000000000`;
+    const temporary = ["history_off", "conv_key"].map(prefix => ({
+      ...auth[0], name: `${prefix}_${id}`, value: prefix === "history_off" ? "1" : "synthetic",
+    }));
+    if (protectedCookies) await host.setChatGptCookies(temporary);
+    else for (const cookie of temporary) await cookieStore.set(cookie);
+  }
+  const remaining = await cookieStore.get({ domain: "chatgpt.com" });
+  const tokens = remaining.filter(cookie => cookie.name.startsWith("__Secure-next-auth.session-token"));
+  assert.equal(tokens.length, protectedCookies ? 2 : 0,
+    protectedCookies ? "login must survive cookie garbage collection" : "baseline must reproduce the logout");
+  if (protectedCookies) {
+    contents.debugger.attach("1.3");
+    const { cookies } = await contents.debugger.sendCommand("Network.getCookies", { urls: ["https://chatgpt.com/"] });
+    contents.debugger.detach();
+    assert.ok(cookies.filter(cookie => cookie.name.startsWith("__Secure-next-auth")).every(cookie => cookie.priority === "High"));
+    assert.ok(cookies.filter(cookie => /^(history_off|conv_key)_/.test(cookie.name)).every(cookie => cookie.priority === "Low"));
+    // A deliberate sign-out must still remove the protected cookies.
+    for (const cookie of tokens) await cookieStore.remove("https://chatgpt.com/", cookie.name);
+    assert.equal((await cookieStore.get({ domain: "chatgpt.com" })).some(cookie => cookie.name.startsWith("__Secure-next-auth")), false);
+  }
+  return { protectedCookies, temporaryCookiesInserted: 480, loginChunksRemaining: tokens.length, totalCookies: remaining.length };
+}
+
+app.whenReady().then(async () => {
+  app.dock?.hide();
+  let code = 0;
+  try {
+    console.log(JSON.stringify({ baseline: await stress(false), fixed: await stress(true) }));
+  } catch (error) {
+    console.error(error);
+    code = 1;
+  } finally {
+    for (const window of windows) window.destroy();
+    fs.rmSync(profile, { recursive: true, force: true });
+    app.exit(code);
+  }
+});
