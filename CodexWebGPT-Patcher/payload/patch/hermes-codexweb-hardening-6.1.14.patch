index 0000000..e3e697c
--- /dev/null
+++ b/src/native-sse-recovery.ts
@@ -0,0 +1,77 @@
+import type { NativeFetch } from "./native-passthrough";
+import { fetchNativeResponsesWithRecovery, NATIVE_HTTP_RECOVERY_ATTEMPTS, waitForNativeRecovery } from "./native-recovery";
+
+const TRANSIENT_CODES = new Set(["server_error", "internal_error", "internal_server_error", "upstream_server_error", "service_unavailable", "overloaded_error"]);
+const MAX_PREFIX_BYTES = 64 * 1024;
+
+function frameDisposition(frame: string): "lifecycle" | "retry" | "release" {
+  const data = frame.split(/\r?\n/).filter(line => line.startsWith("data:"))
+    .map(line => line.slice(5).replace(/^ /, "")).join("\n");
+  if (!data) return "lifecycle";
+  try {
+    const event = JSON.parse(data);
+    if (["response.created", "response.in_progress", "response.queued"].includes(event?.type)) return "lifecycle";
+    const response = event?.response;
+    if (event?.type === "response.failed" && response?.status === "failed"
+      && response.retryable !== false && TRANSIENT_CODES.has(response.error?.code)
+      && Array.isArray(response.output) && response.output.length === 0 && !response.output_text) return "retry";
+  } catch { /* Unknown or malformed data must remain observable to the client. */ }
+  return "release";
+}
+
+function replayPrefix(response: Response, reader: ReadableStreamDefaultReader<Uint8Array>, chunks: Uint8Array[]): Response {
+  let index = 0;
+  return new Response(new ReadableStream<Uint8Array>({
+    async pull(controller) {
+      if (index < chunks.length) { controller.enqueue(chunks[index++]!); return; }
+      try {
+        const next = await reader.read();
+        if (next.done) controller.close(); else controller.enqueue(next.value);
+      } catch (error) { controller.error(error); }
+    },
+    cancel(reason) { return reader.cancel(reason); },
+  }), { status: response.status, statusText: response.statusText, headers: response.headers });
+}
+
+/** Buffer lifecycle frames only. Once output starts, the original stream is never replayed. */
+export async function recoverNativeSseResponse(
+  initial: Response,
+  makeRequest: () => Request,
+  fetchUpstream: NativeFetch,
+  wait = waitForNativeRecovery,
+): Promise<Response> {
+  let response = initial;
+  for (let attempt = 0; ; attempt++) {
+    if (!response.ok || !(response.headers.get("content-type") ?? "").toLowerCase().includes("text/event-stream")
+      || !response.body) return response;
+    const reader = response.body.getReader(), chunks: Uint8Array[] = [];
+    const decoder = new TextDecoder(); let pending = "", size = 0, retry = false;
+    try {
+      while (!retry) {
+        const next = await reader.read();
+        if (next.done) return replayPrefix(response, reader, chunks);
+        chunks.push(next.value); size += next.value.byteLength;
+        if (size > MAX_PREFIX_BYTES) return replayPrefix(response, reader, chunks);
+        pending += decoder.decode(next.value, { stream: true });
+        for (;;) {
+          const boundary = /\r?\n\r?\n/.exec(pending);
+          if (!boundary) break;
+          const frame = pending.slice(0, boundary.index); pending = pending.slice(boundary.index + boundary[0].length);
+          const disposition = frameDisposition(frame);
+          if (disposition === "release") return replayPrefix(response, reader, chunks);
+          if (disposition === "retry") { retry = true; break; }
+        }
+      }
+    } catch {
+      // Let the normal transport retry path handle a genuinely truncated connection.
+      // A typed failed response, not absence of bytes, is what authorizes this retry.
+      return replayPrefix(response, reader, chunks);
+    }
+    if (attempt + 1 >= NATIVE_HTTP_RECOVERY_ATTEMPTS) return replayPrefix(response, reader, chunks);
+    await reader.cancel().catch(() => {});
+    const request = makeRequest(), delayMs = Math.min(1000 * 2 ** attempt, 15_000);
+    console.warn(`[codex-chatgpt-web] native_sse_recovery ${JSON.stringify({ attempt: attempt + 2, delayMs })}`);
+    await wait(delayMs, request.signal);
+    response = await fetchNativeResponsesWithRecovery(makeRequest, fetchUpstream, wait);
+  }
+}
