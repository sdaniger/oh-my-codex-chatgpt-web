+import { expect, test } from "bun:test";
+import { TurnMetrics } from "../src/turn-metrics";
+
+test("performance keeps bounded numeric samples and distinguishes reported, estimated and missing usage", () => {
+  const metrics = new TurnMetrics();
+  const exact = metrics.begin(Date.now() - 150);
+  exact.firstOutput();
+  exact.observe({ type: "done", usage: { inputTokens: 12, outputTokens: 3 } });
+  exact.finish("completed");
+  exact.finish("failed"); // duplicate terminal from cancellation must not change the outcome
+  const estimate = metrics.begin();
+  estimate.observe({ type: "error", message: "confidential error", usage: { inputTokens: 7, outputTokens: 2, estimated: true } });
+  estimate.finish("failed");
+  metrics.begin().finish("cancelled");
+  const snapshot = metrics.snapshot();
+  expect(snapshot).toMatchObject({
+    count: 3, completed: 1, failed: 1, cancelled: 1, success_rate_percent: 50,
+    usage: { reported_turns: 1, estimated_turns: 1, unreported_turns: 1,
+      input_tokens: 12, output_tokens: 3, estimated_input_tokens: 7, estimated_output_tokens: 2 },
+  });
+  expect(snapshot.ttft_p50_ms).not.toBeNull();
+  expect(JSON.stringify(snapshot)).not.toContain("confidential");
+  for (let i = 0; i < 105; i++) metrics.begin().finish("completed");
+  expect(metrics.snapshot()).toMatchObject({ count: 100, completed: 100, failed: 0, cancelled: 0 });
+});
