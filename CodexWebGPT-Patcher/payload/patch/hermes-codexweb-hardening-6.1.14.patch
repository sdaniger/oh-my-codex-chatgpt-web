index 0000000..c06935b
--- /dev/null
+++ b/src/adapters/chatgpt-web/browser-recovery.ts
@@ -0,0 +1,110 @@
+import { ChatGptWebAdapterError } from "./adapter-error";
+import type { BrowserTurn } from "./browser-worker";
+
+export const MAX_BROWSER_PREPARATION_ATTEMPTS = 8;
+const MAX_TEMPORARY_CHAT_PERSONALIZATION_ATTEMPTS = 3;
+const MAX_MISSING_COMPOSER_ATTEMPTS = 3;
+const MAX_STALLED_DOM_PREPARATION_ATTEMPTS = 3;
+
+function missingComposerBeforeSubmission(error: unknown): boolean {
+  return error instanceof Error
+    && error.message === "ChatGPT composer is unavailable. Reload ChatGPT and retry the task.";
+}
+
+function stalledDomObservation(error: unknown): boolean {
+  // Avoid importing browser-worker at runtime: browser-worker imports this module.
+  return error instanceof Error
+    && error.name === "ChatGptBrowserObservationTimeoutError"
+    && /^ChatGPT browser DOM observation did not respond within \d+ms$/.test(error.message);
+}
+
+function temporaryChatPersonalizationControlsMissing(error: unknown): boolean {
+  return error instanceof ChatGptWebAdapterError
+    && error.code === "connector_not_found"
+    && error.status === 424
+    && error.message.startsWith("ChatGPT did not expose usable personalization controls for this Temporary Chat.");
+}
+
+/** Only failures that positively identify an unsent preparation can start another browser. */
+export function recoverableBrowserPreparation(error: unknown): boolean {
+  if (!(error instanceof Error)) return false;
+  if (error instanceof ChatGptWebAdapterError) {
+    return error.code === "browser_helper_start_failed"
+      || temporaryChatPersonalizationControlsMissing(error)
+      || (error.code === "upstream_server_error"
+        && /model controls are unavailable|renderer.*(?:crashed|stopped)|idle document bootstrap/i.test(error.message));
+  }
+  return /ChatGPT browser stage timed out: (?:browser_page|effort_selection)\b/.test(error.message)
+    || stalledDomObservation(error)
+    || missingComposerBeforeSubmission(error)
+    || /ChatGPT model controls are unavailable/.test(error.message)
+    || /Browser renderer stopped during idle document bootstrap/.test(error.message);
+}
+
+function waitForRecovery(ms: number, signal?: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const aborted = () => {
+      clearTimeout(timer);
+      signal?.removeEventListener("abort", aborted);
+      reject(new DOMException("Browser recovery cancelled", "AbortError"));
+    };
+    const timer = setTimeout(() => {
+      signal?.removeEventListener("abort", aborted);
+      resolve();
+    }, ms);
+    signal?.addEventListener("abort", aborted, { once: true });
+    if (signal?.aborted) aborted();
+  });
+}
+
+/** Keep the same logical runtime/HTTP stream while its unsent browser preparation recovers. */
+export async function recoverBrowserPreparation(
+  turn: BrowserTurn,
+  run: (attempt: BrowserTurn) => Promise<string>,
+  wait = waitForRecovery,
+): Promise<string> {
+  let sendActivated = false;
+  const attempt: BrowserTurn = {
+    ...turn,
+    onSendActivated: async () => {
+      sendActivated = true;
+      await turn.onSendActivated?.();
+    },
+    onSubmitted: async () => {
+      sendActivated = true;
+      await turn.onSubmitted?.();
+    },
+    ...(turn.onMultipartStageAcknowledged ? {
+      onMultipartStageAcknowledged: async (stage: number) => {
+        sendActivated = true;
+        await turn.onMultipartStageAcknowledged!(stage);
+      },
+    } : {}),
+  };
+  for (let index = 0; ; index++) {
+    if (turn.abortSignal?.aborted) throw new DOMException("Browser recovery cancelled", "AbortError");
+    try {
+      return await run(attempt);
+    } catch (error) {
+      if (turn.abortSignal?.aborted) throw new DOMException("Browser recovery cancelled", "AbortError");
+      // A Temporary Chat can momentarily fail to hydrate its personalization
+      // controls. Retry a fresh unsent page, but keep genuine missing connector
+      // configuration errors terminal and avoid eight expensive 30s preflights.
+      const maxAttempts = temporaryChatPersonalizationControlsMissing(error)
+        ? MAX_TEMPORARY_CHAT_PERSONALIZATION_ATTEMPTS
+        : missingComposerBeforeSubmission(error)
+          ? MAX_MISSING_COMPOSER_ATTEMPTS
+          : stalledDomObservation(error)
+            ? MAX_STALLED_DOM_PREPARATION_ATTEMPTS
+          : MAX_BROWSER_PREPARATION_ATTEMPTS;
+      if (sendActivated || !recoverableBrowserPreparation(error)
+        || index + 1 >= maxAttempts) throw error;
+      const delayMs = Math.min(1_000 * 2 ** index, 15_000);
+      console.warn(`[chatgpt-web] browser_preparation_recovery ${JSON.stringify({
+        traceId: turn.traceId, attempt: index + 2, maxAttempts, delayMs,
+      })}`);
+      turn.onHeartbeat?.();
+      await wait(delayMs, turn.abortSignal);
+    }
+  }
+}
