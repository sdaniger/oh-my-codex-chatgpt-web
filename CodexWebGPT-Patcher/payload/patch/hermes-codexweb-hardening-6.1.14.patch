diff --git a/tests/native-recovery.test.ts b/tests/native-recovery.test.ts
new file mode 100644
index 0000000..caac6bc
--- /dev/null
+++ b/tests/native-recovery.test.ts
@@ -0,0 +1,34 @@
+import {expect,test} from "bun:test";
+import {fetchNativeResponsesWithRecovery,NATIVE_HTTP_RECOVERY_ATTEMPTS} from "../src/native-recovery";
+
+test("five consecutive 503 responses recover without changing the request or exposing an error",async()=>{
+  let calls=0;const waits:number[]=[];const body=JSON.stringify({input:[{type:"function_call_output",call_id:"already-executed",output:"done"}]});
+  const response=await fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses",{method:"POST",body}),async request=>{
+    expect(await request.text()).toBe(body);return ++calls<=5?new Response("down",{status:503}):new Response("success");
+  },async ms=>{waits.push(ms)});
+  expect(await response.text()).toBe("success");expect(calls).toBe(6);expect(waits).toEqual([1000,2000,4000,8000,15000]);
+});
+
+test.each([400,401,403,404,429])("native %d is returned without a retry",async status=>{
+  let calls=0;const response=await fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses"),async()=>{
+    calls++;return new Response("error",{status});
+  },async()=>{});expect(response.status).toBe(status);expect(calls).toBe(1);
+});
+
+test("provider Retry-After is honored, and an excessive cooldown is returned intact",async()=>{
+  let calls=0;const waits:number[]=[];await fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses"),async()=>{
+    return ++calls===1?new Response("down",{status:503,headers:{"retry-after":"40"}}):new Response("ok");
+  },async ms=>{waits.push(ms)});expect(waits).toEqual([40000]);
+  const response=await fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses"),async()=>new Response("down",{status:503,headers:{"retry-after":"300"}}),async()=>{throw Error("early retry")});
+  expect(response.headers.get("retry-after")).toBe("300");
+});
+
+test("stop interrupts native backoff, and persistent failure remains bounded",async()=>{
+  const abort=new AbortController();let calls=0;
+  await expect(fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses",{signal:abort.signal}),async()=>{
+    calls++;setTimeout(()=>abort.abort(),0);return new Response("down",{status:503});
+  })).rejects.toMatchObject({name:"AbortError"});expect(calls).toBe(1);
+  calls=0;const response=await fetchNativeResponsesWithRecovery(()=>new Request("http://127.0.0.1/responses"),async()=>{
+    calls++;return new Response("down",{status:503});
+  },async()=>{});expect(calls).toBe(NATIVE_HTTP_RECOVERY_ATTEMPTS);expect(response.status).toBe(503);
+});
