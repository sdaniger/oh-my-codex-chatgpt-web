diff --git a/src/native-recovery.ts b/src/native-recovery.ts
new file mode 100644
index 0000000..fb039e9
--- /dev/null
+++ b/src/native-recovery.ts
@@ -0,0 +1,36 @@
+import type { NativeFetch } from "./native-passthrough";
+
+const RETRYABLE_STATUS = new Set([408, 500, 502, 503, 504]);
+export const NATIVE_HTTP_RECOVERY_ATTEMPTS = 8;
+
+export function waitForNativeRecovery(ms: number, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const stop = () => { clearTimeout(timer); signal.removeEventListener("abort", stop); reject(signal.reason); };
+    const timer = setTimeout(() => { signal.removeEventListener("abort", stop); resolve(); }, ms);
+    signal.addEventListener("abort", stop, { once: true });
+    if (signal.aborted) stop();
+  });
+}
+
+/** Retry rejected HTTP requests before exposing a stream; never replay a consumed SSE response. */
+export async function fetchNativeResponsesWithRecovery(
+  makeRequest: () => Request,
+  fetchUpstream: NativeFetch,
+  wait = waitForNativeRecovery,
+): Promise<Response> {
+  for (let attempt = 0; ; attempt++) {
+    const request = makeRequest();
+    if (request.signal.aborted) throw request.signal.reason;
+    const response = await fetchUpstream(request);
+    if (!RETRYABLE_STATUS.has(response.status) || attempt + 1 >= NATIVE_HTTP_RECOVERY_ATTEMPTS) return response;
+    const retryAfter = response.headers.get("retry-after");
+    const declaredDelay = retryAfter === null ? 0 : /^\d+(?:\.\d+)?$/.test(retryAfter.trim())
+      ? Number(retryAfter) * 1000 : Math.max(0, Date.parse(retryAfter) - Date.now());
+    // Do not shorten a provider cooldown that cannot fit inside this recovery cycle.
+    if (Number.isFinite(declaredDelay) && declaredDelay > 120_000) return response;
+    const delayMs = Math.max(Math.min(1000 * 2 ** attempt, 15_000), Number.isFinite(declaredDelay) ? declaredDelay : 0);
+    await response.body?.cancel().catch(() => {});
+    console.warn(`[codex-chatgpt-web] native_http_recovery ${JSON.stringify({status: response.status, attempt: attempt + 2, delayMs})}`);
+    await wait(delayMs, request.signal);
+  }
+}
