+/**
+ * Codex can open an empty turn before the goal service supplies its own continuation input.
+ * The request then ends with current-turn context (for example AGENTS.md) while the newest
+ * instruction still belongs to an older turn. Identify that exact shape so the caller can
+ * synthesize the goal instruction from authoritative native goal state.
+ *
+ * A stale replay instead ends with the older instruction itself and must keep failing closed.
+ */
+export function chatGptTurnNeedsGoalContinuation(parsed: CodexParsedRequest): boolean {
+  const identity = extractChatGptTurnIdentity(parsed);
+  const turnId = identity.turnId;
+  if (!turnId || isCodexComposerPrediction(parsed._rawBody)) return false;
+  const body = record(parsed._rawBody);
+  const input = Array.isArray(body?.input) ? body.input : [];
+  const metadata = clientTurnMetadata(parsed);
+  let instructionIndex = -1;
+  for (let index = input.length - 1; index >= 0; index -= 1) {
+    if (userRevision(input[index], turnId, metadata)) {
+      instructionIndex = index;
+      break;
+    }
+  }
+  if (instructionIndex < 0) return false;
+  const revision = userRevision(input[instructionIndex], turnId, metadata);
+  if (!revision || revision.turnId === undefined || revision.turnId === turnId) return false;
+  // A completed compaction continuation has its own authenticated recovery path.
+  if (isAcceptedCompactionContinuation(parsed, identity, revision)) return false;
+  // The current turn must have appended its own native context after the older instruction.
+  // That proves Codex started a new turn without a new human instruction rather than replaying
+  // the older request. Context items are never themselves instructions.
+  return input.slice(instructionIndex + 1).some(value => {
+    const item = record(value);
+    return item !== undefined && itemTurnId(item) === turnId && contextualUserMessage(item);
+  });
+}
