new file mode 100644
index 0000000..c476981
--- /dev/null
+++ b/src/turn-metrics.ts
@@ -0,0 +1,61 @@
+import type { AdapterEvent, CodexUsage } from "./types";
+import type { ResponsesTerminalStatus } from "./bridge";
+
+type Outcome = ResponsesTerminalStatus | "cancelled";
+type Sample = { status: Outcome; durationMs: number; ttftMs: number | null; usage?: CodexUsage };
+
+/** Bounded, in-memory numeric diagnostics. Never retain prompts, identities, or error text. */
+export class TurnMetrics {
+  private samples: Sample[] = [];
+
+  begin(startedAt = Date.now()) {
+    let firstAt: number | null = null;
+    let usage: CodexUsage | undefined;
+    let finished = false;
+    const firstOutput = () => { firstAt ??= Date.now(); };
+    return {
+      firstOutput,
+      observe: (event: AdapterEvent) => {
+        if (event.type === "done" || event.type === "incomplete" || event.type === "error") {
+          usage = event.usage ?? usage;
+        }
+      },
+      finish: (status: Outcome) => {
+        if (finished) return;
+        finished = true;
+        const now = Date.now();
+        this.samples.push({ status, durationMs: Math.max(0, now - startedAt),
+          ttftMs: firstAt === null ? null : Math.max(0, firstAt - startedAt), usage });
+        if (this.samples.length > 100) this.samples.shift();
+      },
+    };
+  }
+
+  snapshot() {
+    const samples = this.samples;
+    const count = samples.length;
+    const completed = samples.filter(s => s.status === "completed").length;
+    const failed = samples.filter(s => s.status === "failed").length;
+    const incomplete = samples.filter(s => s.status === "incomplete").length;
+    const cancelled = samples.filter(s => s.status === "cancelled").length;
+    const ttfts = samples.flatMap(s => s.ttftMs === null ? [] : [s.ttftMs]).sort((a, b) => a - b);
+    const percentile = (p: number) => ttfts.length ? ttfts[Math.ceil(ttfts.length * p) - 1] : null;
+    const exact = samples.filter(s => s.usage && s.usage.estimated !== true);
+    const estimated = samples.filter(s => s.usage?.estimated === true);
+    return {
+      count, completed, failed, incomplete, cancelled,
+      success_rate_percent: count - cancelled ? Math.round(100 * completed / (count - cancelled)) : null,
