+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { Database } from "bun:sqlite";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { parseRequest } from "../src/responses/parser";
+import { defaultConfig } from "../src/config";
+import { responseRequest } from "../src/server";
+import {
+  chatGptTurnNeedsGoalContinuation,
+  extractChatGptCompactionSourceRevision,
+  extractChatGptTurnIdentity,
+  extractChatGptTurnUserRevision,
+} from "../src/adapters/chatgpt-web/environment";
+import {
+  applyChatGptGoalContinuation,
+  chatGptGoalContinuationText,
+  resolveActiveCodexThreadGoal,
+} from "../src/adapters/chatgpt-web/goal-continuation";
+import { rememberCompactionContinuation } from "../src/adapters/chatgpt-web/compaction-continuation";
+import { SUMMARY_PREFIX } from "../src/responses/compaction";
+
+const cwd = resolve(process.cwd());
+const homes: string[] = [];
+const threadId = "01a176af-e95d-72d2-9d24-ee1230840b79";
+const turnId = "01a176b0-3da1-7dd1-8e72-2211a26f0eaf";
+const objective = "まだエラーが出るから絶対エラーが起きないようにして";
+
+function textOf(content: unknown): string {
+  if (typeof content === "string") return content;
+  if (!Array.isArray(content)) return "";
+  return content.map(part => typeof part === "object" && part !== null && "text" in part
+    ? String((part as { text?: unknown }).text ?? "") : "").join("\n");
+}
+
+function createHome(): string {
+  const home = mkdtempSync(join(tmpdir(), "codex-goal-home-"));
+  homes.push(home);
+  return home;
+}
+
+function writeGoal(
+  home: string,
+  goal: { threadId?: string; objective?: string; status?: string; tokensUsed?: number; tokenBudget?: number | null } = {},
+): void {
+  mkdirSync(home, { recursive: true });
+  const database = new Database(join(home, "goals_1.sqlite"));
+  database.run(`
+    CREATE TABLE IF NOT EXISTS thread_goals (
+      thread_id TEXT PRIMARY KEY NOT NULL,
+      goal_id TEXT NOT NULL,
+      objective TEXT NOT NULL,
+      status TEXT NOT NULL,
+      token_budget INTEGER,
+      tokens_used INTEGER NOT NULL DEFAULT 0,
+      time_used_seconds INTEGER NOT NULL DEFAULT 0,
+      created_at_ms INTEGER NOT NULL,
+      updated_at_ms INTEGER NOT NULL
+    )
+  `);
+  database.query(`
+    INSERT OR REPLACE INTO thread_goals
+      (thread_id, goal_id, objective, status, token_budget, tokens_used, time_used_seconds, created_at_ms, updated_at_ms)
+    VALUES (?, ?, ?, ?, ?, ?, 0, ?, ?)
+  `).run(
+    goal.threadId ?? threadId,
+    "goal-1",
+    goal.objective ?? objective,
+    goal.status ?? "active",
+    goal.tokenBudget === undefined ? null : goal.tokenBudget,
+    goal.tokensUsed ?? 120,
+    Date.now(),
+    Date.now(),
+  );
+  database.close();
+}
+
+function metadata(ownerThread = threadId, ownerTurn = turnId): Record<string, unknown> {
+  return {
+    request_kind: "turn",
+    thread_id: ownerThread,
+    turn_id: ownerTurn,
+    sandbox: "danger-full-access",
+    workspaces: { [cwd]: {} },
+  };
+}
+
+const previousInstruction = {
+  type: "message",
+  role: "user",
+  id: "msg_previous_instruction",
+  content: [{ type: "input_text", text: "/goal fix the remaining failures" }],
+  internal_chat_message_metadata_passthrough: {
+    turn_id: "01a176af-e95d-72d2-9d24-ee1230840b79",
+    content_item_kinds: ["user.text"],
+  },
+};
+
+const agentsMd = {
+  type: "message",
+  role: "user",
+  id: "msg_agents_md",
+  content: [{ type: "input_text", text: "# AGENTS.md instructions\n\n<INSTRUCTIONS>\nKeep tests green.\n</INSTRUCTIONS>" }],
+  internal_chat_message_metadata_passthrough: {
+    turn_id: turnId,
+    content_item_kinds: ["agents_md.instructions"],
+  },
+};
+
+function failingTurnWire(ownerThread = threadId, ownerTurn = turnId): Record<string, unknown> {
+  return {
+    model: "chatgpt-web/gpt-6-sol",
+    reasoning: { effort: "high" },
+    stream: false,
+    instructions: "You are Codex.",
+    client_metadata: { "x-codex-turn-metadata": JSON.stringify(metadata(ownerThread, ownerTurn)) },
+    input: [
+      previousInstruction,
+      {
+        type: "message",
+        role: "assistant",
+        content: [{ type: "output_text", text: "The previous task completed." }],
+      },
+      agentsMd,
+    ],
+  };
+}
+
+beforeEach(() => {
+  // Each test creates homes through createHome; this reset keeps cleanup scoped.
+});
+
+afterEach(() => {
+  for (const home of homes.splice(0)) rmSync(home, { recursive: true, force: true });
+});
+
+describe("Codex thread goal lookup", () => {
+  test("reads only an authoritative active goal", () => {
+    const home = createHome();
+    writeGoal(home, { tokenBudget: 10_000 });
+    expect(resolveActiveCodexThreadGoal({ codexHome: home, threadId })).toEqual({
+      objective,
+      status: "active",
+      tokensUsed: 120,
+      tokenBudget: 10_000,
+    });
+
+    const blocked = new Database(join(home, "goals_1.sqlite"));
+    blocked.run("UPDATE thread_goals SET status = 'blocked'");
+    blocked.close();
+    expect(resolveActiveCodexThreadGoal({ codexHome: home, threadId })).toBeUndefined();
+  });
+
+  test("fails closed when the goal is missing, malformed, or ambiguous across trusted homes", () => {
+    const home = createHome();
+    expect(resolveActiveCodexThreadGoal({ codexHome: home, threadId })).toBeUndefined();
+
+    writeGoal(home, { objective: "   " });
+    expect(resolveActiveCodexThreadGoal({ codexHome: home, threadId })).toBeUndefined();
+
+    writeGoal(home);
+    const duplicate = createHome();
+    writeGoal(duplicate, { objective: "different objective" });
+    expect(resolveActiveCodexThreadGoal({
+      codexHome: home,
+      additionalCodexHomes: [duplicate],
+      threadId,
+    })).toBeUndefined();
+  });
+});
+
+describe("goal continuation detection and application", () => {
+  test("recognizes the empty goal turn after an older human instruction", () => {
+    const home = createHome();
+    writeGoal(home);
+    const parsed = parseRequest(failingTurnWire());
+    expect(chatGptTurnNeedsGoalContinuation(parsed)).toBe(true);
+
+    const goal = resolveActiveCodexThreadGoal({ codexHome: home, threadId })!;
+    applyChatGptGoalContinuation(parsed, goal);
+
+    const text = chatGptGoalContinuationText(goal);
+    expect(text).toContain(`<objective>\n${objective}\n</objective>`);
+    expect(textOf(extractChatGptTurnUserRevision(parsed))).toBe(text);
+    const rawInput = (parsed._rawBody as { input: Array<Record<string, unknown>> }).input;
+    expect(rawInput.at(-1)).toMatchObject({
+      type: "message",
+      role: "user",
+      internal_chat_message_metadata_passthrough: {
+        turn_id: turnId,
+        content_item_kinds: ["goal.internal_context"],
+      },
+    });
+    expect(parsed.context.messages.at(-1)?.content).toBe(text);
+
+    // Applying twice must not duplicate the synthetic instruction on a replayed request shape.
+    applyChatGptGoalContinuation(parsed, goal);
+    expect(rawInput.filter(item => item.id === `msg_goal_continuation_${turnId}`)).toHaveLength(1);
+  });
+
+  test("keeps stale replays, aborted turns, predictions, and normal steering fail-closed", () => {
+    const stale = structuredClone(failingTurnWire());
+    (stale.input as unknown[]).pop();
+    expect(chatGptTurnNeedsGoalContinuation(parseRequest(stale))).toBe(false);
+    expect(() => extractChatGptTurnUserRevision(parseRequest(stale)))
+      .toThrow("conflicts with native Codex turn_id metadata");
+
+    const aborted = structuredClone(failingTurnWire());
+    (aborted.input as Record<string, unknown>[]).splice(1, 0, {
+      type: "message",
+      role: "user",
+      id: "msg_aborted",
+      content: [{ type: "input_text", text: "<turn_aborted>interrupted</turn_aborted>" }],
+      internal_chat_message_metadata_passthrough: {
+        turn_id: "01a176af-e95d-72d2-9d24-ee1230840b79",
+        content_item_kinds: ["turn.aborted"],
+      },
+    });
+    expect(chatGptTurnNeedsGoalContinuation(parseRequest(aborted))).toBe(true);
+
+    const prediction = structuredClone(failingTurnWire(threadId, "prediction-turn"));
+    (prediction.client_metadata as Record<string, string>)["x-codex-turn-metadata"] = JSON.stringify({
+      ...metadata(threadId, "prediction-turn"),
+      turn_trigger: "composer_predictions",
+    });
+    expect(chatGptTurnNeedsGoalContinuation(parseRequest(prediction))).toBe(false);
+
+    const normal = structuredClone(failingTurnWire());
+    (normal.input as Record<string, unknown>[]).push({
+      type: "message",
+      role: "user",
+      id: "msg_current_instruction",
+      content: [{ type: "input_text", text: "Continue with the next check." }],
+      internal_chat_message_metadata_passthrough: {
+        turn_id: turnId,
+        content_item_kinds: ["user.text"],
+      },
+    });
+    const parsed = parseRequest(normal);
+    expect(chatGptTurnNeedsGoalContinuation(parsed)).toBe(false);
+    expect(textOf(extractChatGptTurnUserRevision(parsed))).toBe("Continue with the next check.");
+  });
+
+  test("keeps a synthetic goal source across compaction recovery", () => {
+    const home = createHome();
+    writeGoal(home);
+    const parsed = parseRequest(failingTurnWire());
+    applyChatGptGoalContinuation(parsed, resolveActiveCodexThreadGoal({ codexHome: home, threadId })!);
+    const source = extractChatGptCompactionSourceRevision({
+      ...parsed,
+      _compactionRequest: true,
+    }, { recoverCheckpoint: false });
+    expect(textOf(source.content)).toBe(chatGptGoalContinuationText(resolveActiveCodexThreadGoal({ codexHome: home, threadId })!));
+
+    const compactionTurn = "01a176b1-0000-7000-8000-000000000001";
+    const compaction = {
+      ...parsed,
+      _compactionRequest: true,
+      _rawBody: {
+        ...(parsed._rawBody as Record<string, unknown>),
+        client_metadata: { "x-codex-turn-metadata": JSON.stringify(metadata(threadId, compactionTurn)) },
+      },
+    };
+    const identity = extractChatGptTurnIdentity(compaction);
+    const summary = "The goal remains active.";
+    rememberCompactionContinuation(compaction, identity, [source], summary);
+
+    // v1 installs only the summary plus current native context; the synthetic goal is dropped.
+    const continuation = {
+      ...compaction,
+      _compactionRequest: false,
+      _rawBody: {
+        ...(compaction._rawBody as Record<string, unknown>),
+        input: [
+          { ...agentsMd, internal_chat_message_metadata_passthrough: {
+            turn_id: compactionTurn, content_item_kinds: ["agents_md.instructions"],
+          } },
+          {
+            type: "message",
+            role: "user",
+            id: "msg_goal_summary",
+            content: [{ type: "input_text", text: `${SUMMARY_PREFIX}\n${summary}` }],
+          },
+        ],
+      },
+    };
+    expect(textOf(extractChatGptTurnUserRevision(continuation))).toBe(textOf(source.content));
+    expect(chatGptTurnNeedsGoalContinuation(continuation)).toBe(false);
+  });
+});
+
+describe("goal continuation in the responses pipeline", () => {
+  test("repairs a blocked empty goal turn from the authoritative goal database", async () => {
+    const home = createHome();
