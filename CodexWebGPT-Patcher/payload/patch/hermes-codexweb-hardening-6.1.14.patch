new file mode 100644
index 0000000..dd028bd
--- /dev/null
+++ b/tests/native-sse-recovery.test.ts
@@ -0,0 +1,53 @@
+import {expect,test} from "bun:test";
+import {recoverNativeSseResponse} from "../src/native-sse-recovery";
+import {NATIVE_HTTP_RECOVERY_ATTEMPTS} from "../src/native-recovery";
+const request=()=>new Request("http://127.0.0.1/responses",{method:"POST",body:'{"input":[]}'});
+const frame=(type:string,fields:object={})=>`event: ${type}\ndata: ${JSON.stringify({type,...fields})}\n\n`;
+const failed=(fields:object={})=>frame("response.created",{response:{id:"old"}})+frame("response.failed",{response:{status:"failed",output:[],error:{code:"server_error"},...fields}});
+const sse=(data:string)=>new Response(data,{headers:{"content-type":"text/event-stream"}});
+
+test("HTTP 200 failures before output recover without exposing the old response or restarting tools",async()=>{
+  const success=frame("response.created",{response:{id:"new"}})+frame("response.output_text.delta",{delta:"done"});let calls=0;
+  const response=await recoverNativeSseResponse(sse(failed()),request,async r=>{
+    expect(await r.text()).toBe('{"input":[]}');return ++calls<3?sse(failed()):sse(success);
+  },async()=>{});
+  expect(await response.text()).toBe(success);expect(calls).toBe(3);
+});
+
+test.each([frame("response.output_text.delta",{delta:"partial"}),frame("response.output_item.added",{item:{type:"function_call",call_id:"executed"}})])(
+  "any answer or tool output disables automatic replay",async prefix=>{
+    const data=prefix+failed();const response=await recoverNativeSseResponse(sse(data),request,async()=>{throw Error("duplicate execution")},async()=>{});
+    expect(await response.text()).toBe(data);
+  });
+
+test.each([{retryable:false},{output:[{type:"function_call"}]},{output_text:"already delivered"},{error:{code:"usage_limit_reached"}}])(
+  "an explicit terminal or partial failure is passed through: %j",async fields=>{
+    const data=failed(fields);const response=await recoverNativeSseResponse(sse(data),request,async()=>{throw Error("unexpected retry")},async()=>{});
+    expect(await response.text()).toBe(data);
+  });
+
+test("partial frames and non-SSE errors retain their actual meaning",async()=>{
+  const data=failed().slice(0,-1);const response=await recoverNativeSseResponse(sse(data),request,async()=>{throw Error("retry")},async()=>{});expect(await response.text()).toBe(data);
+  const auth=await recoverNativeSseResponse(sse(failed()),request,async()=>new Response("expired login",{status:401}),async()=>{});
+  expect(auth.status).toBe(401);expect(await auth.text()).toBe("expired login");
+});
+
+test("buffering is bounded and does not interpret a completion marker quoted in output",async()=>{
+  for(const data of [frame("response.created",{metadata:"x".repeat(70000)}),frame("response.output_text.delta",{delta:failed()})]){
