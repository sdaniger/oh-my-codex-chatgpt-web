@@ -0,0 +1,169 @@
+import { expect, test } from "bun:test";
+import { ChatGptWebAdapterError } from "../src/adapters/chatgpt-web/adapter-error";
+import { ChatGptBrowserObservationTimeoutError, ChatGptBrowserWorker, type BrowserTurn } from "../src/adapters/chatgpt-web/browser-worker";
+import { MAX_BROWSER_PREPARATION_ATTEMPTS, recoverBrowserPreparation } from "../src/adapters/chatgpt-web/browser-recovery";
+
+const controlError = () => new ChatGptWebAdapterError("ChatGPT model controls are unavailable. Reload ChatGPT and retry the task.", {
+  status: 502, errorType: "server_error", code: "upstream_server_error", retryable: false,
+});
+const temporaryChatControlsError = () => new ChatGptWebAdapterError(
+  "ChatGPT did not expose usable personalization controls for this Temporary Chat. If the connector works in a regular chat, enable Launcher → Settings → Save chats in ChatGPT",
+  { status: 424, errorType: "connector_error", code: "connector_not_found", retryable: false },
+);
+const turn = (): BrowserTurn => ({ traceId: "recovery-test", modelId: "gpt-5.6-sol",
+  capabilities: { localToolsEnabled: false, solAvailable: true, extraHighAvailable: false, proAvailable: false },
+  prepare: async () => ({ text: "test", images: [], release() {} }), onTextDelta() {},
+});
+
+test("preparation recovers beyond three failures in the same turn without emitting an error", async () => {
+  const original = turn(), waits: number[] = []; let runs = 0, sent = 0;
+  original.onSubmitted = () => { sent++; };
+  expect(await recoverBrowserPreparation(original, async attempt => {
+    expect(attempt.traceId).toBe(original.traceId);
+    if (++runs < 5) throw controlError();
+    await attempt.onSendActivated?.(); await attempt.onSubmitted?.(); return "done";
+  }, async ms => { waits.push(ms); })).toBe("done");
+  expect(waits).toEqual([1000, 2000, 4000, 8000]); expect(sent).toBe(1);
+});
+
+test("an intermittently missing Temporary Chat personalization control recovers before sending", async () => {
+  const waits: number[] = []; let runs = 0, submits = 0;
+  const original = turn(); original.onSubmitted = () => { submits++; };
+  expect(await recoverBrowserPreparation(original, async active => {
+    if (++runs < 3) throw temporaryChatControlsError();
+    await active.onSendActivated?.(); await active.onSubmitted?.(); return "recovered";
+  }, async ms => { waits.push(ms); })).toBe("recovered");
+  expect(runs).toBe(3); expect(submits).toBe(1);
+  expect(waits).toEqual([1000, 2000]);
+});
+
+test("persistent missing Temporary Chat controls stop after three unsent preparations", async () => {
+  let runs = 0;
+  await expect(recoverBrowserPreparation(turn(), async () => {
+    runs++; throw temporaryChatControlsError();
+  }, async () => {})).rejects.toMatchObject({ code: "connector_not_found" });
+  expect(runs).toBe(3);
+});
+
+test("a missing composer on a newly prepared page recovers without duplicate submission", async () => {
+  const waits: number[] = []; let runs = 0, sends = 0;
+  const original = turn(); original.onSubmitted = () => { sends++; };
+  expect(await recoverBrowserPreparation(original, async active => {
+    if (++runs < 3) throw new Error("ChatGPT composer is unavailable. Reload ChatGPT and retry the task.");
+    await active.onSendActivated?.(); await active.onSubmitted?.(); return "ready";
+  }, async ms => { waits.push(ms); })).toBe("ready");
+  expect(runs).toBe(3); expect(sends).toBe(1); expect(waits).toEqual([1000, 2000]);
+});
+
+test("a persistently missing composer stays bounded, while unrelated failures stay terminal", async () => {
+  for (const [message, expectedRuns] of [
+    ["ChatGPT composer is unavailable. Reload ChatGPT and retry the task.", 3],
+    ["ChatGPT composer is disabled by a policy", 1],
+  ] as const) {
+    let runs = 0;
+    await expect(recoverBrowserPreparation(turn(), async () => {
+      runs++; throw new Error(message);
+    }, async () => {})).rejects.toThrow(message);
+    expect(runs).toBe(expectedRuns);
+  }
+});
+
+test("a missing composer after send activation is never replayed", async () => {
+  let runs = 0;
+  await expect(recoverBrowserPreparation(turn(), async active => {
+    runs++; await active.onSendActivated?.();
+    throw new Error("ChatGPT composer is unavailable. Reload ChatGPT and retry the task.");
+  }, async () => {})).rejects.toThrow("composer is unavailable");
+  expect(runs).toBe(1);
+});
+
+test("stalled DOM observation before submission recovers with exactly one send", async () => {
+  const waits: number[] = []; let runs = 0, sends = 0;
+  const original = turn(); original.onSubmitted = () => { sends++; };
+  expect(await recoverBrowserPreparation(original, async active => {
+    if (++runs < 3) throw new ChatGptBrowserObservationTimeoutError(5_000);
+    await active.onSendActivated?.(); await active.onSubmitted?.(); return "recovered";
+  }, async ms => { waits.push(ms); })).toBe("recovered");
+  expect(runs).toBe(3); expect(sends).toBe(1); expect(waits).toEqual([1_000, 2_000]);
+});
+
+test("stalled DOM observation after send activation must not replay submission", async () => {
+  let runs = 0;
+  await expect(recoverBrowserPreparation(turn(), async active => {
+    runs++; await active.onSendActivated?.();
+    throw new ChatGptBrowserObservationTimeoutError(5_000);
+  }, async () => {})).rejects.toBeInstanceOf(ChatGptBrowserObservationTimeoutError);
+  expect(runs).toBe(1);
+});
+
+test("only the typed DOM observation timeout is recoverable", async () => {
+  let runs = 0;
+  await expect(recoverBrowserPreparation(turn(), async () => {
+    runs++; throw new Error("ChatGPT browser DOM observation did not respond within 5000ms");
+  }, async () => {})).rejects.toThrow("DOM observation did not respond");
+  expect(runs).toBe(1);
+});
+
+test("missing configured connector and unsafe browser states are not retried", async () => {
+  for (const message of [
+    "ChatGPT connector menu opened but exposed no row named Codex Web GPT",
+    "ChatGPT exposed an invalid Temporary Chat personalization state",
+  ]) {
+    let runs = 0;
+    await expect(recoverBrowserPreparation(turn(), async () => {
+      runs++; throw new ChatGptWebAdapterError(message, {
+        status: 424, code: "connector_not_found", errorType: "connector_error", retryable: false,
+      });
+    }, async () => {})).rejects.toThrow(message);
+    expect(runs).toBe(1);
+  }
+});
+
+test("a personalization failure after sending never retries", async () => {
+  let runs = 0;
+  await expect(recoverBrowserPreparation(turn(), async active => {
+    runs++; await active.onSendActivated?.(); throw temporaryChatControlsError();
+  }, async () => {})).rejects.toMatchObject({ code: "connector_not_found" });
+  expect(runs).toBe(1);
+});
+
+test.each(["onSendActivated", "onSubmitted", "onMultipartStageAcknowledged"] as const)(
+  "a failure after %s never submits another browser prompt", async callback => {
+    const original = turn(); original.onMultipartStageAcknowledged = () => {};
+    let runs = 0;
+    await expect(recoverBrowserPreparation(original, async attempt => {
+      runs++; await (attempt[callback] as (stage: number) => void | Promise<void>)(1); throw controlError();
+    }, async () => {})).rejects.toThrow("model controls"); expect(runs).toBe(1);
+  });
+
+test.each(["model_version_unavailable", "client_cancelled", "chatgpt_tool_approval_required", "context_length_exceeded"])(
+  "permanent %s failures do not retry", async code => {
+    let runs = 0;
+    await expect(recoverBrowserPreparation(turn(), async () => {
+      runs++; throw new ChatGptWebAdapterError(code, { status: 400, code, errorType: "invalid_request_error", retryable: false });
+    }, async () => {})).rejects.toThrow(code); expect(runs).toBe(1);
+  });
+
+test("recovery is bounded and retains the last actual failure", async () => {
+  let runs = 0; const error = controlError();
+  await expect(recoverBrowserPreparation(turn(), async () => { runs++; throw error; }, async () => {})).rejects.toBe(error);
+  expect(runs).toBe(MAX_BROWSER_PREPARATION_ATTEMPTS);
+});
+
+test("stop cancels the backoff immediately without starting another attempt", async () => {
+  const abort = new AbortController(); let runs = 0;
+  const pending = recoverBrowserPreparation({ ...turn(), abortSignal: abort.signal }, async () => {
+    runs++; setTimeout(() => abort.abort(), 0); throw controlError();
+  });
+  await expect(pending).rejects.toMatchObject({ name: "AbortError" }); expect(runs).toBe(1);
+});
+
+test("the production worker keeps its active-run identity through preparation recovery", async () => {
+  const worker = ChatGptBrowserWorker.forProvider({ adapter: "chatgpt-web", baseUrl: "browser://recovery-wiring",
+    chatgptWeb: { localToolsEnabled: false, solAvailable: true } });
+  const seam = worker as unknown as { runExclusive: (turn: BrowserTurn) => Promise<string> };
+  const original = seam.runExclusive; let attempts = 0;
+  seam.runExclusive = async () => { if (++attempts === 1) throw controlError(); return "recovered"; };
+  try { expect(await worker.run(turn())).toBe("recovered"); expect(attempts).toBe(2); }
+  finally { seam.runExclusive = original; }
+});
