+          return "enabled";
+        }
+      } catch (error) {
+        try {
+          await restoreChatGptPersonalizationChoice(page, toggleReceipt);
+        } catch (restoreError) {
+          throw new ChatGptPersistentBrowserStateError(
+            [error, restoreError],
